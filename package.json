{
  "name": "mma-dashboard",
  "private": true,
  "version": "12.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test src/utils/*.test.js",
    "test:card-prompt": "node --test src/utils/cardAnalysisPrompt.test.js",
    "test:results": "node --test src/utils/betResults.test.js",
    "test:ufc": "python -m unittest discover -s api/ufcstats -p test_*.py",
    "test:pfl": "python -m unittest discover -s api/providers/espn_mma -p test_*.py",
    "test:one": "python -m unittest discover -s api/providers/one_championship -p test_*.py",
    "test:lfa": "python -m unittest discover -s api/providers/lfa -p test_*.py",
    "test:bkfc": "python -m unittest discover -s api/providers/bkfc -p test_*.py",
    "test:catalog": "python -m unittest discover -s api/providers/event_catalog -p test_*.py",
    "test:odds": "python -m unittest discover -s api/providers/the_odds_api -p test_*.py",
    "test:retention": "python -m unittest api.sync.test_incremental api.sync.test_retention api.sync.test_transient_retry api.sync.test_card_reconciliation api.sync.test_data_quality api.sync.test_freshness",
    "test:history": "python -m unittest discover -s api/providers/fighter_history -p test_*.py",
    "sync:now": "python api/sync/weekly_sync.py --mode daily",
    "sync:repair": "python api/sync/weekly_sync.py --mode repair --past-days 30 --future-days 90 --full-repair",
    "sync:ufc": "python api/sync/weekly_sync.py --mode daily --skip-pfl --skip-one --skip-lfa --skip-bkfc --skip-odds --skip-retention --requested-scope ufc",
    "sync:ufc-repair": "python api/sync/weekly_sync.py --mode repair --past-days 30 --future-days 90 --full-repair --skip-pfl --skip-one --skip-lfa --skip-bkfc --skip-odds --skip-retention --requested-scope ufc",
    "sync:pfl": "python api/sync/weekly_sync.py --mode daily --skip-ufc --skip-one --skip-lfa --skip-bkfc --skip-odds --skip-stats --skip-retention --requested-scope pfl",
    "sync:one": "python api/sync/weekly_sync.py --mode daily --skip-ufc --skip-pfl --skip-lfa --skip-bkfc --skip-odds --skip-stats --skip-retention --requested-scope one",
    "sync:lfa": "python api/sync/weekly_sync.py --mode daily --skip-ufc --skip-pfl --skip-one --skip-bkfc --skip-odds --skip-stats --skip-retention --requested-scope lfa",
    "sync:bkfc": "python api/sync/weekly_sync.py --mode daily --skip-ufc --skip-pfl --skip-one --skip-lfa --skip-odds --skip-stats --skip-retention --requested-scope bkfc",
    "sync:odds": "python api/sync/weekly_sync.py --mode daily --skip-catalog --skip-ufc --skip-pfl --skip-one --skip-lfa --skip-bkfc --skip-stats --skip-retention",
    "sync:dry-run": "python api/sync/weekly_sync.py --mode daily --dry-run --skip-odds --skip-stats",
    "sync:history": "python api/sync/weekly_sync.py --mode maintenance --past-days 3650 --future-days 90 --skip-ufcstats --skip-odds --skip-stats --skip-retention --skip-catalog --no-dashboard-status",
    "sync:history:maintenance": "python api/sync/history_maintenance.py",
    "sync:history:ufc": "python api/sync/weekly_sync.py --mode maintenance --past-days 3650 --future-days 90 --skip-ufcstats --skip-pfl --skip-one --skip-lfa --skip-bkfc --skip-odds --skip-stats --skip-retention --skip-catalog --no-dashboard-status --requested-scope ufc",
    "sync:history:pfl": "python api/sync/weekly_sync.py --mode maintenance --past-days 3650 --future-days 90 --skip-ufc --skip-one --skip-lfa --skip-bkfc --skip-odds --skip-stats --skip-retention --skip-catalog --no-dashboard-status --requested-scope pfl",
    "sync:history:one": "python api/sync/weekly_sync.py --mode maintenance --past-days 3650 --future-days 90 --skip-ufc --skip-pfl --skip-lfa --skip-bkfc --skip-odds --skip-stats --skip-retention --skip-catalog --no-dashboard-status --requested-scope one",
    "sync:history:lfa": "python api/sync/weekly_sync.py --mode maintenance --past-days 3650 --future-days 90 --skip-ufc --skip-pfl --skip-one --skip-bkfc --skip-odds --skip-stats --skip-retention --skip-catalog --no-dashboard-status --requested-scope lfa",
    "sync:history:bkfc": "python api/sync/weekly_sync.py --mode maintenance --past-days 3650 --future-days 90 --skip-ufc --skip-pfl --skip-one --skip-lfa --skip-odds --skip-stats --skip-retention --skip-catalog --no-dashboard-status --requested-scope bkfc",
    "retention:preview": "python api/sync/retention.py --preview",
    "retention:apply": "python api/sync/retention.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
